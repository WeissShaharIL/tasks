# Bootstrap — shared postgres credentials (used by deploy.sh to create the tasks DB)
POSTGRES_USER=
POSTGRES_DB=

# Application DB user (created by deploy.sh if missing)
TASKS_DB_USER=tasks
TASKS_DB_PASSWORD=
TASKS_DB_NAME=tasks

# Connection string the backend reads
DATABASE_URL=postgresql+psycopg2://tasks:CHANGE_ME@postgres:5432/tasks

# JWT signing key — must be a long random string in production
SECRET_KEY=

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Seeded admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=מנהל מערכת

# CORS — leave empty if all traffic goes through nginx
CORS_ORIGINS=
