# Bootstrap — shared postgres credentials (used by deploy.sh to create the tasks DB)
POSTGRES_USER=
POSTGRES_DB=

# Application DB user (created by deploy.sh if missing)
TASKS_DB_USER=tasks
TASKS_DB_PASSWORD=
TASKS_DB_NAME=tasks

# Connection string the backend reads
DATABASE_URL=postgresql+psycopg2://tasks:CHANGE_ME@postgres:5432/tasks

# JWT signing key — must be a long random string in production
SECRET_KEY=

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Seeded admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=מנהל מערכת

# CORS — leave empty if all traffic goes through nginx
CORS_ORIGINS=

# Web Push (VAPID). Generate once:
#   docker exec tasks-backend-1 python -c "import push_service; push_service.print_new_keys()"
# Then paste the two printed lines here. Leave empty to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@works-on-my-machine.net
